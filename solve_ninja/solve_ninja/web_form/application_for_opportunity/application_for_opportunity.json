 "client_script": "frappe.web_form.after_load = () => {\n  console.log(\"\u2705 mentee feedback prefill running\");\n\n  const urlParams = new URLSearchParams(window.location.search);\n  const request_id = urlParams.get(\"request_id\");\n  console.log(\"request_id:\", request_id);\n\n  if (!request_id) return;\n\n  // Set request_id on the form (this also ensures it's visible/stored)\n  frappe.web_form.set_value(\"request_id\", request_id);\n\n  // Reusable logic (same pattern as handle_opportunity_change)\n  prefill_names_from_request_id(request_id);\n};\n\nfunction prefill_names_from_request_id(request_id) {\n  frappe.call({\n    method: \"frappe.client.get\",\n    args: {\n      doctype: \"Mentorship Request\",\n      name: request_id,\n      // keep it lean: only fetch what you need\n      fields: [\"mentor_name\", \"mentee_name\"]\n    },\n    callback: function (r) {\n      if (r.exc) return;\n\n      const doc = r.message;\n      if (!doc) return;\n\n      frappe.web_form.set_value(\"mentor_full_name\", doc.mentor_name || \"\");\n      frappe.web_form.set_value(\"mentee_full_name\", doc.mentee_name || \"\");\n    }\n  });\n}\n",
